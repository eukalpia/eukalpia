# Source lives in app/, design docs in docs/. Everything else at the root stays out of git.
/*
!/.gitignore
!/README.md
!/COPYRIGHT.md
!/.github/
!/.github/**
!/site/
!/site/**
!/public/
!/app/
!/app/**
!/docs/
!/docs/**
/public/*
!/public/profile-cover.svg
!/public/profile-ascii.svg
!/public/THIRD-PARTY-NOTICES.txt
*.map
.DS_Store
node_modules/
/app/dist/
/app/test-results/
/app/.vite/
